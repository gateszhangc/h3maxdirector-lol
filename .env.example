# app
NEXT_PUBLIC_APP_URL = "https://h3maxdirector.lol"
NEXT_PUBLIC_APP_NAME = "H3 Max Director"
NEXT_PUBLIC_APP_DESCRIPTION = "Direct continuous realtime video with live prompts while preserving characters, settings, and story continuity."
NEXT_PUBLIC_APP_LOGO = "/logo.svg"
NEXT_PUBLIC_APP_FAVICON = "/favicon.png"
NEXT_PUBLIC_APP_PREVIEW_IMAGE = "/preview.png"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "light"

# database
DATABASE_PROVIDER = "sqlite"
DATABASE_URL = "file:data/local.db"
DB_SCHEMA_FILE = "./src/config/db/schema.sqlite.ts"
DB_MIGRATIONS_OUT = "./src/config/db/migrations_sqlite"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""

# auth providers
EMAIL_AUTH_ENABLED = "false"
GITHUB_AUTH_ENABLED = "false"

# google auth
GOOGLE_AUTH_ENABLED = "true"
GOOGLE_ONE_TAP_ENABLED = "false"
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""

# payments (Creem; use sandbox credentials for local validation)
SELECT_PAYMENT_ENABLED = "true"
DEFAULT_PAYMENT_PROVIDER = "creem"
CREEM_ENABLED = "true"
CREEM_ENVIRONMENT = "sandbox"
CREEM_API_KEY = ""
CREEM_SIGNING_SECRET = ""
CREEM_PRODUCT_IDS = '{"h3max-starter-monthly":"prod_test_xxx","h3max-pro-monthly":"prod_test_xxx","h3max-premium-monthly":"prod_test_xxx","h3max-starter-yearly":"prod_test_xxx","h3max-pro-yearly":"prod_test_xxx","h3max-premium-yearly":"prod_test_xxx"}'
